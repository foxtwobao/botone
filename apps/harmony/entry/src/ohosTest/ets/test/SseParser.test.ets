// Replays the committed byte-level SSE fixture (generated by driving the REAL mobile
// subscribeThread with scripted chunks). The idle case is transport behavior and is covered
// by SseTransport against the fixture server, not by the pure parser.
import { describe, expect, it } from '@ohos/hypium';
import { fixtureSse } from './fixtures.generated';
import { SseParser } from '../../../main/ets/net/sse';
import type { SseEvent } from '../../../main/ets/net/sse';
import { expandChunk, recordOf, stableJson, stringField, boolField } from './test-utils';

export default function sseParserTest() {
  describe('SseParserFixture', () => {
    const fixture = recordOf(fixtureSse);

    it('framing_matches_mobile_byte_for_byte', 0, () => {
      for (const item of fixture['cases'] as Object[]) {
        const entry = item as Record<string, Object>;
        const name = stringField(entry, 'name');
        if (boolField(entry, 'idle')) {
          continue;
        }
        const events: SseEvent[] = [];
        const parser = new SseParser((event: SseEvent): void => {
          events.push(event);
        });
        let rangeError = false;
        try {
          for (const chunk of entry['chunks'] as Object[]) {
            parser.feed(expandChunk(chunk as Record<string, Object>));
          }
        } catch (err) {
          if (err instanceof RangeError) {
            rangeError = true;
          } else {
            throw err as Error;
          }
        }
        expect(rangeError).assertEqual(stringField(entry, 'error') === 'range');
        const expected = stableJson(entry['events']);
        const actual = stableJson(events);
        if (actual !== expected) {
          throw new Error(`case "${name}" diverged:\nexpected ${expected}\nactual   ${actual}`);
        }
      }
    });
  });
}
