            {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]{1,120}$",
                  "type": "string"
                },
                "type": {
                  "const": "header",
                  "type": "string"
                }
              },
              "required": ["type", "name"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "basic",
                  "type": "string"
                },
                "username": {
                  "maxLength": 200,
                  "minLength": 1,
                  "pattern": "^[^:\\r\\n]+$",
                  "type": "string"
                }
              },
              "required": ["type", "username"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "login",
                  "type": "string"
                }
              },
              "required": ["type"],
