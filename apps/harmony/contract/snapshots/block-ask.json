                }
              },
              "required": ["type"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "contact",
                  "type": "string"
                }
              },
              "required": ["type"],
              "type": "object"
            }
          ]
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "type": "string"
        },
        "origin": {
          "default": "",
          "maxLength": 2048,
          "type": "string"
        }
      },
      "required": ["name", "origin", "auth"],
      "type": "object"
